# HMIS V4 DICOM bridge — clinic PC configuration
# Copy to .env and fill in. NEVER commit .env.

# CDC HMS API base URL (include /api)
HMIS_API_URL=https://api.cdiabetescentre.com/api

# Shared secret — must match INGEST_API_KEY in the server's backend/.env
INGEST_API_KEY=

# DICOM listener (what the HS70A connects to)
AE_TITLE=WARDPC
DICOM_PORT=11112
BIND_ADDRESS=0.0.0.0

# Local folders (defaults are relative to this folder)
# INCOMING_DIR=C:\hmis-bridge\incoming
# QUEUE_DIR=C:\hmis-bridge\queue
# LOG_FILE=C:\hmis-bridge\bridge.log

# Upload retry cadence (seconds)
RETRY_INTERVAL_SECONDS=60
UPLOAD_TIMEOUT_SECONDS=60
