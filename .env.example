# Server
PORT=3000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cdc_hms
DB_USER=root
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Email (Nodemailer - use Gmail App Password or SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Password Reset Token (milliseconds - default 1 hour)
RESET_TOKEN_EXPIRES_IN=3600000

# CareLink Encryption Key (required)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Generate once and never change — changing it makes existing encrypted data unreadable.
CARELINK_ENCRYPTION_KEY=your_64_char_hex_key_here

# Ultrasound ingest key (HMIS V4 — DICOM bridge machine auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match INGEST_API_KEY in the clinic PC's bridge/.env. Leave unset to
# disable the ingest endpoint entirely (fails closed with 503).
INGEST_API_KEY=

# Password given to every account created by `npm run seed`.
# Set this for a test/staging environment you log into yourself — one known
# password across the seeded accounts is the point. Leave it UNSET when seeding
# a real clinic, and each account gets its own random passphrase instead.
# Must pass the app's own policy: 8+ chars, upper, lower, number, symbol.
SEED_PASSWORD=
